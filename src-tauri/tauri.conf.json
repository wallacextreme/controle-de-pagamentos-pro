{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Controle de Pagamentos PRO",
  "version": "1.3.0",
  "identifier": "com.controledepagamentos.pro",
  "build": {
    "beforeBuildCommand": "bun scripts/copy-dist.js",
    "beforeDevCommand": "bun scripts/copy-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Controle de Pagamentos PRO",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Controle de Pagamentos PRO",
    "copyright": "Copyright © 2026 Controle de Pagamentos PRO",
    "shortDescription": "Controle de Pagamentos PRO — Gestão Financeira",
    "longDescription": "Sistema completo de controle de pagamentos multi-bancos, parcelamentos, relatórios de impressão e comparativo lado a lado.",
    "windows": {
      "nsis": {
        "languages": [
          "Portuguese"
        ]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
